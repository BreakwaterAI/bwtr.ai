#!/usr/bin/env bash
set -euo pipefail

printf 'curl %s\n' "$*" >>"${BWTR_TEST_LOG}"
output=""
headers=false
url=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --output) output="$2"; shift 2 ;;
    -fsSI) headers=true; shift ;;
    http*) url="$1"; shift ;;
    *) shift ;;
  esac
done
if [[ "${headers}" == true ]]; then
  if [[ "${url}" =~ \.[0-9a-f]{12}\.(css|js|webp)$ ]]; then
    cache_control='public, max-age=31536000, immutable'
  else
    cache_control='no-cache'
  fi
  printf 'HTTP/2 200\r\nContent-Type: image/jpeg\r\nCache-Control: %s\r\n\r\n' \
    "${cache_control}" >"${output}"
else
  relative_path="${url#${BWTR_SITE_BASE_URL}/}"
  case "${relative_path}" in
    ""|*/) relative_path="${relative_path}index.html" ;;
  esac
  cp "${BWTR_ARTIFACT}/${relative_path}" "${output}"
fi
